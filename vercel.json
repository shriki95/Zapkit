{
  "version": 2,
  "name": "zapkit",
  "buildCommand": "cd tinylink-pro/frontend && npm install && npm run build && cd ../../qr-generator-pro/frontend && npm install && npm run build && cd ../..",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/tinylink/(.*)",
      "dest": "/tinylink/$1"
    },
    {
      "src": "/tinylink",
      "dest": "/tinylink/index.html"
    },
    {
      "src": "/qr/(.*)",
      "dest": "/qr/$1"
    },
    {
      "src": "/qr",
      "dest": "/qr/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/home/$1"
    },
    {
      "src": "/",
      "dest": "/home/index.html"
    }
  ]
}
