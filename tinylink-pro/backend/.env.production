# Production Environment Variables
# Copy these to Render.com dashboard

SECRET_KEY=your-secret-key-will-be-generated-by-render
DATABASE_URL=postgresql://user:password@host:5432/dbname
BASE_URL=https://your-backend-url.onrender.com
ALLOWED_ORIGINS=https://your-tinylink-app.vercel.app,https://your-qr-app.vercel.app,https://your-home-page.vercel.app

# Email settings (optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@zapkit.com
